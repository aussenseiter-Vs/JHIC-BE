# Local Postgres (pgvector) connection string (docker compose up db)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jhic?sslmode=disable

# Optional: server port (default 8080)
PORT=8080

# Local image storage directory (relative to the working dir, or /app/data in Docker)
STORAGE_DIR=data

# OpenAI-compatible LLM endpoint (chatbot + nexxa-match + cv-review)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=115
LLM_MAX_TOKENS=1500
# Local Hugging Face TEI embeddings (docker compose up embeddings)
LLM_EMBED_BASE_URL=http://localhost:8081/v1
LLM_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Knowledge base (RAG) settings
KB_DIR=kb
KB_MAX_RESULTS=5
KB_AUTO_SEED=true

# In-memory per-session chat history
CHAT_HISTORY_MAX=20
CHAT_HISTORY_TTL=1800
AI_RATE_LIMIT=10

# Comma-separated list of browser origins allowed by CORS. "*" (default) allows any origin.
CORS_ALLOWED_ORIGINS=*